<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Indicates that the app can use SMS features on devices with telephony support. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Requests permission to send SMS notifications to the user. -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WeightTrackerJustinCarloFlorida">

        <!-- Displays the user's weight dashboard and history. -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.WeightTrackerJustinCarloFlorida.Dashboard" />

        <!-- Allows the user to enter a new daily weight record. -->
        <activity
            android:name=".AddWeightActivity"
            android:exported="false"
            android:theme="@style/Theme.WeightTrackerJustinCarloFlorida.Dashboard" />

        <!-- Allows the user to review and update the goal weight. -->
        <activity
            android:name=".EditGoalActivity"
            android:exported="false"
            android:theme="@style/Theme.WeightTrackerJustinCarloFlorida.Dashboard" />

        <!-- Allows the user to review SMS notification preferences. -->
        <activity
            android:name=".SmsSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.WeightTrackerJustinCarloFlorida.Dashboard" />

        <!-- Launches the login screen when the application starts. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>