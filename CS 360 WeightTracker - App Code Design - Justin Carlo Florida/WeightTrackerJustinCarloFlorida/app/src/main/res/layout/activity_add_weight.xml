<?xml version="1.0" encoding="utf-8"?>

<!--
    Developer: Justin Carlo Florida
    Course: CS 360 - Mobile Architecture and Programming
    Project Three: Weight-Tracking App

    This layout allows the user to enter a new daily weight,
    select a date, add optional notes, and save the entry.
-->

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true"
    tools:context=".AddWeightActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="30dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Screen title establishes the first visual focus. -->
        <TextView
            android:id="@+id/textViewAddWeightTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_weight_title"
            android:textColor="#238C88"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewAddWeightSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/add_weight_subtitle"
            android:textColor="#607D8B"
            android:textSize="15sp" />

        <!-- Displays the user's current goal for reference. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#E8F5E9"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_goal_weight"
                android:textColor="#48626A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewEntryGoalWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/no_goal_set"
                android:textColor="#2E7D5B"
                android:textSize="25sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Weight input field. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/weight_label"
            android:textColor="#37474F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextWeightEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/weight_hint"
            android:inputType="numberDecimal"
            android:minHeight="52dp"
            android:padding="12dp" />

        <!-- Date input field. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/date_label"
            android:textColor="#37474F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextWeightDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/date_hint"
            android:inputType="date"
            android:minHeight="52dp"
            android:padding="12dp" />

        <!-- Optional notes field. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/notes_label"
            android:textColor="#37474F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextWeightNotes"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:gravity="top|start"
            android:hint="@string/notes_hint"
            android:inputType="textMultiLine"
            android:padding="12dp" />

        <!-- Primary action for saving the new weight entry. -->
        <Button
            android:id="@+id/buttonSaveWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="#3AAFA9"
            android:text="@string/save_entry"
            android:textColor="#FFFFFF" />

        <!-- Returns to the dashboard without saving. -->
        <Button
            android:id="@+id/buttonCancelWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#78909C"
            android:text="@string/cancel"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>