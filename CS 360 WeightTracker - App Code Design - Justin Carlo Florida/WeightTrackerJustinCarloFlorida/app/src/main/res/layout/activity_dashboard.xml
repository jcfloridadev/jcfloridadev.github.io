<?xml version="1.0" encoding="utf-8"?>

<!--
    Developer: Justin Carlo Florida
    Course: CS 360 - Mobile Architecture and Programming
    Project Three: Weight-Tracking App

    This layout displays the user's weight summary, goal progress,
    weight-history grid, and controls for managing weight information.
-->

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true"
    tools:context=".DashboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- Dashboard heading and user greeting. -->
        <TextView
            android:id="@+id/textViewDashboardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_title"
            android:textColor="#238C88"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/welcome_back"
            android:textColor="#546E7A"
            android:textSize="16sp" />

        <!-- Current and goal weight summary cards. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:id="@+id/layoutCurrentWeight"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="#D9F2F0"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/current_weight"
                    android:textColor="#48626A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textViewCurrentWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/no_entry"
                    android:textColor="#238C88"
                    android:textSize="27sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutGoalWeight"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#E8F5E9"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goal_weight"
                    android:textColor="#48626A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textViewGoalWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/no_goal"
                    android:textColor="#2E7D5B"
                    android:textSize="27sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Brief progress summary. -->
        <TextView
            android:id="@+id/textViewProgressSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/progress_prompt"
            android:textColor="#37474F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Weight-history section heading. -->
        <TextView
            android:id="@+id/textViewHistoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/weight_history"
            android:textColor="#238C88"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/weight_history_subtitle"
            android:textColor="#607D8B"
            android:textSize="14sp" />

        <!-- Dynamic grid populated with the logged-in user's SQLite weight records. -->

        <TableLayout
            android:id="@+id/tableLayoutWeightHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:stretchColumns="0,1,2">

            <!-- Grid column headings. -->
            <TableRow
                android:id="@+id/tableRowHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#3AAFA9"
                android:padding="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/date_label"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/weight_label"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/change_label"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/action_label"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

            </TableRow>

        </TableLayout>

        <!-- Primary action for adding a new weight entry. -->
        <Button
            android:id="@+id/buttonAddWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#3AAFA9"
            android:text="@string/add_weight_entry"
            android:textColor="#FFFFFF" />

        <!-- Secondary dashboard actions. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/buttonEditGoal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:backgroundTint="#5A8F8C"
                android:text="@string/edit_goal"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/buttonSmsSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:backgroundTint="#5A8F8C"
                android:text="@string/sms_settings"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- Logs the current user out and returns to the login screen. -->
        <Button
            android:id="@+id/buttonLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="18dp"
            android:backgroundTint="#78909C"
            android:text="@string/log_out"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>