<?xml version="1.0" encoding="utf-8"?>

<!--
    Developer: Justin Carlo Florida
    Course: CS 360 - Mobile Architecture and Programming
    Project Three: Weight-Tracking App

    This layout allows the user to review the current goal weight
    and enter a new goal weight and optional target date.
-->

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true"
    tools:context=".EditGoalActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="30dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Screen title establishes the primary visual focus. -->
        <TextView
            android:id="@+id/textViewEditGoalTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_goal_title"
            android:textColor="#238C88"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewEditGoalSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/edit_goal_subtitle"
            android:textColor="#607D8B"
            android:textSize="15sp" />

        <!-- Displays the user's current goal. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#E8F5E9"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_goal_weight"
                android:textColor="#48626A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewCurrentGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/no_goal_set"
                android:textColor="#2E7D5B"
                android:textSize="25sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- New goal weight input field. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/new_goal_weight"
            android:textColor="#37474F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextNewGoalWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/goal_weight_hint"
            android:inputType="numberDecimal"
            android:minHeight="52dp"
            android:padding="12dp" />

        <!-- Optional target date input field. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/target_date"
            android:textColor="#37474F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextGoalDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/date_hint"
            android:inputType="date"
            android:minHeight="52dp"
            android:padding="12dp" />

        <!-- Optional motivational note. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/goal_note"
            android:textColor="#37474F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextGoalNote"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:gravity="top|start"
            android:hint="@string/goal_note_hint"
            android:inputType="textMultiLine"
            android:padding="12dp" />

        <!-- Saves the updated goal information. -->
        <Button
            android:id="@+id/buttonSaveGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="#3AAFA9"
            android:text="@string/save_goal"
            android:textColor="#FFFFFF" />

        <!-- Returns to the dashboard without saving. -->
        <Button
            android:id="@+id/buttonCancelGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#78909C"
            android:text="@string/cancel"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>